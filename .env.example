# ===== Dwechatword 配置 =====

# 公众号名称（仅通道 api 需要，用于后台搜索本人账号获取 fakeid）
MP_ACCOUNT_NAME=放牛班的Spring

# ---------------- 通道选择 ----------------
# api     = 后台接口批量导出（需扫码登录，仅本人公众号，按全部文章抓取）
# article = 文章页直抓（免登录，绕过后台接口频控，需提供文章链接）
CHANNEL=api

# ---------------- 导出格式 ----------------
# 逗号分隔，支持 word / pdf / md 任意组合
EXPORT_FORMATS=word,pdf,md

# ---------------- 路径 ----------------
# 登录会话文件（扫码后自动保存，无需改动）
SESSION_FILE=session.json
# 导出目录
OUTPUT_DIR=output
# 图片缓存目录
IMAGE_CACHE_DIR=.image_cache

# ---------------- 抓取行为（默认偏保守，降低触发微信频控概率） ----------------
# 每页文章数（微信公众平台一次最多 5 条）
PAGE_SIZE=5
# 最大抓取页数（0 表示不限制，抓完为止）
MAX_PAGES=0
# 翻页间隔秒数（基础值，实际随机上浮，防频控；建议 10~15）
PAGE_INTERVAL=10
# 频控触发后的等待秒数（建议 120 以上）
RATE_LIMIT_WAIT=120
# 单篇文章抓取间隔秒数（基础值）
ARTICLE_INTERVAL=5

# ---------------- 文章页直抓（通道 B）反爬参数 ----------------
# 单篇文章抓取超时（秒）
ARTICLE_TIMEOUT=30
# 抓取失败/触发验证后的重试次数
ARTICLE_RETRIES=3
# 重试退避基础秒数（指数递增）
ARTICLE_RETRY_WAIT=3
# 直抓失败时是否回退到后台接口通道（需已登录）
ARTICLE_FALLBACK_API=false

# Word 文档版本号（文件命名用）
DOC_VERSION=v1.0
