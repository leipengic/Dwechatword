# ===== Dwechatword 配置 =====
# 公众号名称（用于后台搜索本人账号，获取 fakeid）
MP_ACCOUNT_NAME=放牛班的Spring

# 登录会话文件（扫码后自动保存，无需改动）
SESSION_FILE=session.json

# 导出目录
OUTPUT_DIR=output

# 图片缓存目录
IMAGE_CACHE_DIR=.image_cache

# 每页文章数（微信公众平台一次最多 5 条）
PAGE_SIZE=5

# 最大抓取页数（0 表示不限制，抓完为止）
MAX_PAGES=0

# 翻页间隔秒数（基础值，实际会随机上浮，防频控；建议 10~15）
PAGE_INTERVAL=10

# 频控触发后的等待秒数（建议 120 以上）
RATE_LIMIT_WAIT=120

# 单篇文章抓取间隔秒数（基础值）
ARTICLE_INTERVAL=5

# Word 文档版本号（文件命名用）
DOC_VERSION=v1.0
